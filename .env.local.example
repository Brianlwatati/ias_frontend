# Base URL of ias_backend (Express 5 API)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Optional: default tenant/company slug for multi-tenant login screens
NEXT_PUBLIC_DEFAULT_TENANT=

# Cookie name used to store the access token client-side reference (httpOnly refresh token stays server-set)
NEXT_PUBLIC_AUTH_COOKIE_NAME=ias_session
